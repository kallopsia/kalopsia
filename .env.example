# Salin menjadi .env.local lalu isi nilainya. Jangan commit file .env* yang berisi rahasia.
# Lihat docs/SETUP.md untuk cara memperoleh setiap nilai.

# --- Supabase (Proyek → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (Dashboard → Settings) ---
# Unsigned upload memakai preset + cloud name saja.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=notebook-archive
# Signed upload + sinkron foto (Admin API) butuh keduanya; hanya dibaca di server.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Checkout WhatsApp (nomor penjual, tidak pernah dikirim ke browser) ---
WHATSAPP_NUMBER=6281234567890
